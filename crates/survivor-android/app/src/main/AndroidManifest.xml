<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The pretend server talks to the client over loopback sockets, which need this. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Tirisfall Survivor"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@style/Fullscreen">
        <activity
            android:name=".SurvivorActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="survivor_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
